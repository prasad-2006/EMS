{
  "watch": ["*.js", "routes/*.js", "controllers/*.js", "models/*.js", "middleware/*.js", "config/*.js"],
  "ignore": ["node_modules/", "test/", "*.test.js"],
  "ext": "js,json",
  "delay": "1000",
  "signal": "SIGTERM",
  "env": {
    "NODE_ENV": "development"
  },
  "events": {
    "restart": "echo \\n🔄 Restarting server...",
    "crash": "echo \\n❌ Server crashed - waiting for changes..."
  }
}
