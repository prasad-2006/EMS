{
  "name": "vacation-tracking-backend",
  "version": "1.0.0",
  "description": "Backend API for Vacation Tracking System",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "clean": "node cleanup.js",
    "dev:safe": "node scripts/free_port.js && nodemon server.js",
    "kill-port": "node scripts/free_port.js",
    "predev": "node scripts/free_port.js",
    "db:migrate": "node scripts/migrate_database.js --apply",
    "db:migrate:dry-run": "node scripts/migrate_database.js",
    "db:migrate:user-departments": "node scripts/migrate_user_departments.js",
    "verify:coverage": "node scripts/verify_coverage_workflow.js",
    "test": "jest --runInBand"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.4.1",
    "express-validator": "^7.0.1",
    "helmet": "^8.0.0",
    "json2csv": "^6.0.0-alpha.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^7.5.0",
    "multer": "^2.1.1",
    "node-cron": "^4.2.1",
    "nodemailer": "^8.0.4",
    "pdfkit": "^0.18.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "nodemon": "^3.0.1",
    "jest": "^29.0.0",
    "supertest": "^6.3.3",
    "mongodb-memory-server": "^8.12.0"
  }
}
